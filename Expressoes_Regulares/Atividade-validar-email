import re

regex_email = (
    r"^(?!\.)"                  # não começa com ponto
    r"(?!.*\.\@)"               # não tem ponto imediatamente antes do @
    r"(?!.*\.\.)"               # não possui dois pontos consecutivos
    r"(?!.*@-)"                 # domínio não começa com hífen
    r"(?!.*\.-)"                # parte do domínio não termina com hífen
    r"(?!.*-\.)(?!.*-$)"        # hífen não termina parte do domínio
    r"[A-Za-z0-9._+-]+"
    r"@"
    r"[A-Za-z0-9.-]+"
    r"\.[A-Za-z]{2,}$"
)

emails_validos = []
emails_invalidos = []

for x in range(5):

    email_digitado = input("Insira um endereço de email a ser validado: ")

    if re.fullmatch(regex_email, email_digitado):

        print("Aceito")
        emails_validos.append(email_digitado)

    else:

        print("Negado")

        if "@" not in email_digitado:
            print("Motivo: o email não possui @")

        elif email_digitado.startswith("@"):
            print("Motivo: não existe usuário antes do @")

        elif email_digitado.endswith("@"):
            print("Motivo: não existe domínio depois do @")

        elif "." not in email_digitado.split("@")[-1]:
            print("Motivo: o domínio não possui extensão, como .com ou .br")

        elif not re.search(r"[A-Za-z]{2,}$", email_digitado):
            print("Motivo: a extensão deve possuir pelo menos 2 letras")

        else:
            print("Motivo: o formato do email inválido")

        emails_invalidos.append(email_digitado)


print("Emails válidos:", emails_validos)
print("Emails inválidos:", emails_invalidos)




Esta atividade foi feita em python por mim com auxílio de uma LLM. Este código tem a finalidade de validar emails por meio de uma expressão regular que define regras de formato ao email inserido.
